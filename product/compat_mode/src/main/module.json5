{
  "module": {
    "name": "compat_mode",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "CompatEntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "requestPermissions": [
//      {
//        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
//      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.LOCATION_IN_BACKGROUND",
        "usedScene": {
          "when": "inuse"
        },
        "reason": "$string:setting_keep_background"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "usedScene": {
          "when": "inuse"
        },
        "reason": "$string:setting_keep_background"
      }
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "CompatEntryAbility",
        "srcEntry": "./ets/compatentryability/CompatEntryAbility.ets",
        "description": "$string:CompatEntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:CompatEntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ],
        "backgroundModes": [
          "location"
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "Compat_modeBackupAbility",
        "srcEntry": "./ets/compat_modebackupability/Compat_modeBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}